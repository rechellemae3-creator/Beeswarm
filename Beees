	row = Color3.fromRGB(22, 22, 27),
	accent = Color3.fromRGB(0, 106, 255),
	on = Color3.fromRGB(0, 106, 255),
	text = Color3.fromRGB(255, 255, 255),
	dim = Color3.fromRGB(185, 185, 195),
}

local state = {
	alive = true,
	fields = {},
	ring = 0,
	waypointAt = os.clock(),
	moveAt = 0,
	lastClick = 0,
	lastSwing = 0,
	lastConvert = os.clock(),
	tokens = 0,
	converting = false,
	tokenTarget = nil,
	tokenSince = 0,
	hiveOverride = nil,
}

local tokenCooldowns = setmetatable({}, { __mode = "k" })
local gui = { fieldDisplays = {}, status = nil }
local connections = {}

local function track(connection)
	table.insert(connections, connection)
	return connection
end

local function setStatus(text)
	if gui.status and gui.status.Parent then
		gui.status.Text = text
	end
end

local function getEvents()
	return ReplicatedStorage:FindFirstChild("Events")
end

local function fireEvent(name, ...)
	local events = getEvents()
	local remote = events and events:FindFirstChild(name)
	if not remote then
		setStatus("Missing remote: " .. name)
		return false
	end
	local ok = pcall(remote.FireServer, remote, ...)
	if not ok then
		setStatus("Remote failed: " .. name)
	end
	return ok
end

local function getRoot()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil, nil
end

local function zeroVelocity(root)
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
end

-- Short hops across frames. One long CFrame jump gets snapped back by the server,
-- which is why the old teleports only worked sometimes.
local function relocate(target, stepSize)
	local root = getRoot()
	if not root then
		return false
	end

	local step = stepSize or CONFIG.stepDistance
	local start = root.Position
	local steps = math.clamp(math.ceil((target - start).Magnitude / step), 1, 60)

	for index = 1, steps do
		if not state.alive then
			return false
		end
		root = getRoot()
		if not root then
			return false
		end
		root.CFrame = CFrame.new(start:Lerp(target, index / steps))
		zeroVelocity(root)
		RunService.Heartbeat:Wait()
	end

	for _ = 1, 3 do
		root = getRoot()
		if not root then
			return false
		end
		root.CFrame = CFrame.new(target)
		zeroVelocity(root)
		RunService.Heartbeat:Wait()
	end

	root = getRoot()
	return root ~= nil and (root.Position - target).Magnitude <= CONFIG.arriveRadius + 5
end

local function normalize(text)
	return (string.lower(text):gsub("[^%a%d]", ""))
end

-- Fields live in Workspace.FlowerZones as one part per field. FlowerZones can
-- also contain parts that do not match a known name, so those are kept too.
local function scanFields()
	local zones = workspace:FindFirstChild("FlowerZones")
	local parts = {}

	if zones then
		for _, child in ipairs(zones:GetChildren()) do
			if child:IsA("BasePart") then
				table.insert(parts, child)
			end
		end
	end

	local result = {}
	local used = {}

	for _, fieldName in ipairs(FIELD_NAMES) do
		local target = normalize(fieldName)
		for _, part in ipairs(parts) do
			if not used[part] then
				local key = normalize(part.Name)
				if key ~= "" and (key == target or string.find(key, target, 1, true) or string.find(target, key, 1, true)) then
					used[part] = true
					result[fieldName] = part
					break
				end
			end
		end
	end

	for _, part in ipairs(parts) do
		if not used[part] then
			local name = (part.Name:gsub("%s*[Ff]ield%s*$", ""))
			if name == "" then
				name = part.Name
			end
			used[part] = true
			result[name] = part
		end
	end

	return result
end

local function fieldOptions()
	local names = {}
	for _, name in ipairs(FIELD_NAMES) do
		if state.fields[name] then
			table.insert(names, name)
		end
	end
	for name in pairs(state.fields) do
		local known = false
		for _, existing in ipairs(names) do
			if existing == name then
				known = true
				break
			end
		end
		if not known then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

local function getField()
	local part = state.fields[CONFIG.field]
	if part and part.Parent then
		return { name = CONFIG.field, part = part }
	end
	return nil
end

local function fieldPoint(entry)
	local part = entry.part
	local size = part.Size
	local radiusX = math.max(size.X / 2 - 8, 2)
	local radiusZ = math.max(size.Z / 2 - 8, 2)
	local angle = math.rad((state.ring % CONFIG.ringPoints) * (360 / CONFIG.ringPoints) + math.random(-10, 10))
	local offset = Vector3.new(math.cos(angle) * radiusX * 0.8, size.Y / 2 + 4, math.sin(angle) * radiusZ * 0.8)
	return (part.CFrame * CFrame.new(offset)).Position
end

local function insideField(entry, position, margin)
	local localPoint = entry.part.CFrame:PointToObjectSpace(position)
	return math.abs(localPoint.X) <= entry.part.Size.X / 2 + margin
		and math.abs(localPoint.Z) <= entry.part.Size.Z / 2 + margin
end

local function getPollen()
	local stats = player:FindFirstChild("CoreStats")
	local pollen = stats and stats:FindFirstChild("Pollen")
	local capacity = stats and stats:FindFirstChild("Capacity")
	if pollen and capacity and pollen:IsA("ValueBase") and capacity:IsA("ValueBase") then
		return pollen.Value, capacity.Value
	end
	return nil, nil
end

local function shouldConvert()
	if not CONFIG.autoConvert then
		return false
	end
	local pollen, capacity = getPollen()
	if pollen and capacity and capacity > 0 then
		return pollen / capacity >= CONFIG.convertAt
	end
	return os.clock() - state.lastConvert > CONFIG.convertFallback
end

-- Tokens sit in Workspace.Collectibles as parts named "C" or the player's name.
local function nearestToken(position, radius)
	local folder = workspace:FindFirstChild("Collectibles")
	if not folder then
		return nil
	end

	local now = os.clock()
	local best, bestDistance = nil, radius

	for _, part in ipairs(folder:GetChildren()) do
		if part:IsA("BasePart") and (part.Name == "C" or part.Name == player.Name) then
			local tried = tokenCooldowns[part]
			if not tried or now - tried > 1.5 then
				local distance = (part.Position - position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = part, distance
				end
			end
		end
	end

	return best
end

local function touchPart(target)
	if not firetouchinterest then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	for _, limb in ipairs(character:GetChildren()) do
		if limb:IsA("BasePart") then
			pcall(firetouchinterest, limb, target, 0)
			pcall(firetouchinterest, limb, target, 1)
		end
	end
end

local function grabToken(token)
	local root = getRoot()
	if not root or not token.Parent then
		return false
	end

	if CONFIG.tokenMode == "Teleport" then
		relocate(token.Position + Vector3.new(0, 2, 0), 40)
	else
		if (root.Position - token.Position).Magnitude > 10 then
			if state.tokenTarget ~= token then
				state.tokenTarget = token
				state.tokenSince = os.clock()
			end

			-- Unreachable token: give up after 2.5s instead of walking at it forever.
			if os.clock() - state.tokenSince > 2.5 then
				tokenCooldowns[token] = os.clock() + 3
				state.tokenTarget = nil
				return false
			end

			local _, humanoid = getRoot()
			if humanoid then
				humanoid:MoveTo(token.Position)
			end
			return false
		end
	end

	state.tokenTarget = nil

	-- Park on the token for one frame so a real touch happens even without
	-- firetouchinterest, then fire the touch for instant pickup.
	local parked = getRoot()
	if parked then
		parked.CFrame = CFrame.new(token.Position + Vector3.new(0, 2, 0))
		zeroVelocity(parked)
	end
	touchPart(token)
	state.tokenCooldowns[token] = os.clock()
	state.tokens = state.tokens + 1
	return true
end

local function clickScreen()
	local camera = workspace.CurrentCamera
	local position = camera and camera.ViewportSize / 2 or Vector2.new(400, 300)
	pcall(function()
		VirtualUser:Button1Down(position, camera)
		VirtualUser:Button1Up(position, camera)
	end)
end

local function swing()
	local now = os.clock()

	if now - state.lastClick >= CONFIG.clickDelay then
		state.lastClick = now
		clickScreen()
	end

	if now - state.lastSwing < CONFIG.swingDelay then
		return
	end
	state.lastSwing = now

	local character = player.Character
	if not character then
		return
	end

	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = player:FindFirstChildOfClass("Backpack")
		local candidate = backpack and backpack:FindFirstChildOfClass("Tool")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if candidate and humanoid then
			humanoid:EquipTool(candidate)
			tool = candidate
		end
	end

	if tool then
		pcall(function()
			tool:Activate()
		end)
	end
end

local function hivePosition()
	if state.hiveOverride then
		return state.hiveOverride
	end

	local spawnPos = player:FindFirstChild("SpawnPos")
	if spawnPos then
		local value = spawnPos.Value
		if typeof(value) == "Instance" and value:IsA("BasePart") then
			return value.Position
		end
		if typeof(value) == "Vector3" then
			return value
		end
	end

	local honeycombs = workspace:FindFirstChild("Honeycombs")
	if honeycombs then
		for _, hive in ipairs(honeycombs:GetChildren()) do
			local owner = hive:FindFirstChild("Owner")
			if (owner and owner:IsA("ObjectValue") and owner.Value == player) or hive.Name == player.Name then
				if hive:IsA("BasePart") then
					return hive.Position
				end
				if hive:IsA("Model") then
					return hive:GetPivot().Position
				end
			end
		end
	end

	return nil
end

-- Conversion: stand on the hive, fire PlayerHiveCommand("ToggleHoneyMaking"),
-- then wait for pollen to empty. A second command is only sent if nothing
-- happens for 12 seconds, so the toggle is not flipped off by accident.
local function convert()
	if state.converting then
		return
	end

	local position = hivePosition()
	if not position then
		setStatus("No hive found")
		state.lastConvert = os.clock()
		return
	end

	state.converting = true
	setStatus("Converting")
	relocate(position + Vector3.new(0, 3, 0), 45)

	fireEvent("PlayerHiveCommand", "ToggleHoneyMaking")

	local started = os.clock()
	local lastProgress = started
	local lastSeen = getPollen() or math.huge

	while state.alive and state.converting and os.clock() - started < CONFIG.convertTimeout do
		task.wait(0.3)

		local pollen = getPollen()
		if pollen then
			if pollen <= 1 then
				break
			end
			if pollen < lastSeen then
				lastSeen = pollen
				lastProgress = os.clock()
			end
		end

		if os.clock() - lastProgress > 12 then
			fireEvent("PlayerHiveCommand", "ToggleHoneyMaking")
			lastProgress = os.clock()
		end
	end

	state.converting = false
	state.lastConvert = os.clock()
end

local function farmTick()
	local root, humanoid = getRoot()
	if not root then
		setStatus("Waiting for character")
		return
	end

	local entry = getField()
	if not entry then
		setStatus("Pick a field first")
		return
	end

	swing()

	if shouldConvert() then
		convert()
		return
	end

	if CONFIG.collectTokens then
		local token = nearestToken(root.Position, CONFIG.tokenRadius)
		if token then
			if grabToken(token) then
				setStatus(string.format("Token %d | took one", state.tokens))
			else
				setStatus("Going for a token")
			end
			return
		end
	end

	if not insideField(entry, root.Position, 8) then
		setStatus("Going to " .. entry.name)
		relocate(fieldPoint(entry), 60)
		state.waypointAt = os.clock()
		return
	end

	local waypoint = fieldPoint(entry)
	if (root.Position - waypoint).Magnitude <= CONFIG.arriveRadius or os.clock() - state.waypointAt > CONFIG.waypointTimeout then
		state.ring = state.ring + 1
		state.waypointAt = os.clock()
		waypoint = fieldPoint(entry)
	end

	if os.clock() - state.moveAt > 0.25 then
		state.moveAt = os.clock()
		humanoid:MoveTo(waypoint)
	end

	local pollen, capacity = getPollen()
	if pollen and capacity then
		setStatus(string.format("%s | pollen %d/%d | tokens %d", entry.name, pollen, capacity, state.tokens))
	else
		setStatus(string.format("%s | tokens %d", entry.name, state.tokens))
	end
end

local function runLoop()
	while state.alive do
		if CONFIG.autoFarm then
			local ok, err = pcall(farmTick)
			if not ok then
				warn("[KronHub] " .. tostring(err))
				task.wait(0.5)
			end
			task.wait(CONFIG.tickDelay)
		else
			task.wait(0.15)
		end
	end
end

-- UI

local function corner(instance, radius)
	Instance.new("UICorner", instance).CornerRadius = UDim.new(0, radius)
end

local function makeButton(parent, text, order, callback, height)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 392, 0, height or 33)
	button.BackgroundColor3 = COLORS.row
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Font = Enum.Font.SourceSansBold
	button.Text = text
	button.TextColor3 = COLORS.text
	button.TextSize = 14
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.LayoutOrder = order
	button.Parent = parent
	corner(button, 3)

	local padding = Instance.new("UIPadding", button)
	padding.PaddingLeft = UDim.new(0, 10)

	button.MouseButton1Click:Connect(function()
		if callback then
			local ok, err = pcall(callback, button)
			if not ok then
				warn("[KronHub] " .. tostring(err))
			end
		end
	end)

	return button
end

local function makeToggle(parent, text, order, get, set)
	local row = makeButton(parent, "", order, nil)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -80, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.SourceSansBold
	label.Text = text
	label.TextColor3 = COLORS.text
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local back = Instance.new("Frame")
	back.Size = UDim2.fromOffset(40, 18)
	back.Position = UDim2.new(1, -50, 0.5, -9)
	back.BackgroundColor3 = COLORS.panel
	back.BorderSizePixel = 0
	back.Parent = row
	corner(back, 9)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(18, 18)
	knob.Position = UDim2.new(0, 1, 0, 0)
	knob.BackgroundColor3 = COLORS.dim
	knob.BorderSizePixel = 0
	knob.Parent = back
	corner(knob, 9)

	local function paint(animate)
		local on = get()
		local target = on and UDim2.new(1, -19, 0, 0) or UDim2.new(0, 1, 0, 0)
		if animate then
			TweenService:Create(knob, TweenInfo.new(0.12), { Position = target }):Play()
			TweenService:Create(knob, TweenInfo.new(0.12), { BackgroundColor3 = on and COLORS.accent or COLORS.dim }):Play()
		else
			knob.Position = target
			knob.BackgroundColor3 = on and COLORS.accent or COLORS.dim
		end
	end

	row.MouseButton1Click:Connect(function()
		set(not get())
		paint(true)
	end)

	paint(false)
	return row
end

local function makeDropdown(parent, order, placeholder, getValues, onSelect)
	local button = makeButton(parent, placeholder, order, nil)

	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 30, 1, 0)
	arrow.Position = UDim2.new(1, -34, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Font = Enum.Font.SourceSansBold
	arrow.Text = "v"
	arrow.TextColor3 = COLORS.dim
	arrow.TextSize = 13
	arrow.Parent = button

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(0, 392, 0, 0)
	holder.BackgroundColor3 = COLORS.main
	holder.BorderSizePixel = 0
	holder.ClipsDescendants = true
	holder.LayoutOrder = order + 1
	holder.Parent = parent
	corner(holder, 3)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -4, 1, -4)
	scroll.Position = UDim2.fromOffset(2, 2)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 2
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.Parent = holder

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 4)
	end)

	local open = false

	local function setOpen(value)
		open = value
		holder.Size = UDim2.new(0, 392, 0, value and 160 or 0)
		arrow.Text = value and "^" or "v"
	end

	button.MouseButton1Click:Connect(function()
		local values = getValues()
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		if #values == 0 then
			button.Text = "No fields found"
			setOpen(false)
			return
		end

		for index, value in ipairs(values) do
			local option = Instance.new("TextButton")
			option.Size = UDim2.new(1, -4, 0, 28)
			option.BackgroundColor3 = COLORS.row
			option.BorderSizePixel = 0
			option.AutoButtonColor = false
			option.Font = Enum.Font.SourceSans
			option.Text = "  " .. (value:gsub("_", " "))
			option.TextColor3 = COLORS.text
			option.TextSize = 13
			option.TextXAlignment = Enum.TextXAlignment.Left
			option.LayoutOrder = index
			option.Parent = scroll
			corner(option, 2)

			option.MouseButton1Click:Connect(function()
				onSelect(value)
				setOpen(false)
			end)
		end

		setOpen(not open)
	end)

	return {
		button = button,
		close = function()
			setOpen(false)
		end,
	}
end


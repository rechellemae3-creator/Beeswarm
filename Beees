local function setField(name)
	CONFIG.field = name
	for _, label in ipairs(gui.fieldDisplays) do
		if label.Parent then
			label.Text = "Field: " .. (name:gsub("_", " "))
		end
	end
	setStatus("Field: " .. (name:gsub("_", " ")))
end

local function buildGui()
	state.fields = scanFields()

	local parent = (gethui and gethui()) or CoreGui
	local old = parent:FindFirstChild("KronHub")
	if old then
		old:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "KronHub"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 999
	screenGui.Parent = parent
	gui.screenGui = screenGui

	local main = Instance.new("Frame")
	main.Size = UDim2.fromOffset(554, 339)
	main.Position = UDim2.new(0.5, -277, 0.5, -170)
	main.BackgroundColor3 = COLORS.main
	main.BorderSizePixel = 0
	main.Parent = screenGui
	corner(main, 5)
	gui.main = main

	local sidebar = Instance.new("Frame")
	sidebar.Size = UDim2.fromOffset(120, 339)
	sidebar.BackgroundColor3 = COLORS.panel
	sidebar.BorderSizePixel = 0
	sidebar.Parent = main
	corner(sidebar, 5)

	local logo = Instance.new("TextLabel")
	logo.Size = UDim2.new(1, 0, 0, 56)
	logo.BackgroundTransparency = 1
	logo.Font = Enum.Font.SourceSansBold
	logo.Text = "KronHub"
	logo.TextColor3 = COLORS.accent
	logo.TextSize = 18
	logo.Parent = sidebar
	gui.dragHandle = logo

	local tabHolder = Instance.new("Frame")
	tabHolder.Size = UDim2.new(1, -16, 1, -66)
	tabHolder.Position = UDim2.fromOffset(8, 60)
	tabHolder.BackgroundTransparency = 1
	tabHolder.Parent = sidebar

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.Padding = UDim.new(0, 6)
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Parent = tabHolder

	local content = Instance.new("Frame")
	content.Size = UDim2.fromOffset(414, 288)
	content.Position = UDim2.fromOffset(130, 8)
	content.BackgroundTransparency = 1
	content.Parent = main
	gui.content = content

	local status = Instance.new("TextLabel")
	status.Size = UDim2.fromOffset(414, 26)
	status.Position = UDim2.fromOffset(130, 304)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.SourceSans
	status.Text = "Pick a field, then enable Auto Farm."
	status.TextColor3 = COLORS.dim
	status.TextSize = 13
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Parent = main
	gui.status = status

	local tabButtons = {}

	local function showPage(name)
		for pageName, page in pairs(pages) do
			page.Visible = pageName == name
		end
		for buttonName, button in pairs(tabButtons) do
			button.TextColor3 = buttonName == name and COLORS.accent or COLORS.dim
		end
	end

	local function addTab(name, order)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, 32)
		button.BackgroundColor3 = COLORS.main
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Font = Enum.Font.SourceSansBold
		button.Text = name
		button.TextColor3 = COLORS.dim
		button.TextSize = 14
		button.LayoutOrder = order
		button.Parent = tabHolder
		corner(button, 3)
		button.MouseButton1Click:Connect(function()
			showPage(name)
		end)
		tabButtons[name] = button
	end

	local home = makePage(content, "Home")
	local farming = makePage(content, "Farming")
	local teleport = makePage(content, "Teleport")
	local items = makePage(content, "Items")

	addTab("Home", 1)
	addTab("Farming", 2)
	addTab("Teleport", 3)
	addTab("Items", 4)

	-- Home
	makeSection(home, "KronHub rebuild - farming edition", 10)
	makeButton(home, "Rejoin Server", 30, function()
		TeleportService:Teleport(game.PlaceId, player)
	end)
	makeButton(home, "Refresh Fields", 40, function()
		state.fields = scanFields()
		setStatus(string.format("%d fields found", #fieldOptions()))
	end)
	makeButton(home, "Unload", 50, function()
		KronHub.stop()
	end)

	-- Farming
	makeSection(farming, "Farming", 10)

	local farmDropdown = makeDropdown(farming, 20, "Field: " .. (CONFIG.field:gsub("_", " ")), fieldOptions, setField)
	table.insert(gui.fieldDisplays, farmDropdown.button)

	makeToggle(farming, "Auto Farm", 30, function()
		return CONFIG.autoFarm
	end, function(value)
		CONFIG.autoFarm = value
		setStatus(value and "Auto farm on" or "Auto farm off")
	end)

	makeToggle(farming, "Collect Tokens (near only)", 40, function()
		return CONFIG.collectTokens
	end, function(value)
		CONFIG.collectTokens = value
	end)

	makeToggle(farming, "Auto Convert At Hive", 50, function()
		return CONFIG.autoConvert
	end, function(value)
		CONFIG.autoConvert = value
	end)

	makeButton(farming, "Token Mode: " .. CONFIG.tokenMode, 60, function(button)
		CONFIG.tokenMode = CONFIG.tokenMode == "Walk" and "Teleport" or "Walk"
		button.Text = "Token Mode: " .. CONFIG.tokenMode
	end)

	makeButton(farming, "Convert Now", 70, function()
		task.spawn(convert)
	end)

	-- Teleport
	makeSection(teleport, "Locations", 10)

	local teleportDropdown = makeDropdown(teleport, 20, "Field: " .. (CONFIG.field:gsub("_", " ")), fieldOptions, setField)
	table.insert(gui.fieldDisplays, teleportDropdown.button)

	makeButton(teleport, "Teleport To Field", 30, function()
		local entry = getField()
		if not entry then
			setStatus("Pick a field first")
			return
		end
		local ok = relocate(fieldPoint(entry), 60)
		setStatus(ok and ("Teleported to " .. entry.name) or "Teleport failed")
	end)

	makeSection(teleport, "Your Hive", 40)
	makeButton(teleport, "Teleport To Hive", 50, function()
		local position = hivePosition()
		if not position then
			setStatus("No hive found")
			return
		end
		relocate(position + Vector3.new(0, 3, 0), 60)
	end)

	makeButton(teleport, "Set Hive From Here", 60, function()
		local root = getRoot()
		if not root then
			setStatus("No character")
			return
		end
		state.hiveOverride = root.Position
		setStatus("Hive position saved")
	end)

	-- Items
	makeSection(items, "Buffs", 10)
	makeButton(items, "Use All Buffs (Blue)", 20, function()
		for _, name in ipairs({ "Blue Extract", "Glitter", "Glue", "Oil", "Enzymes", "Tropical Drink" }) do
			fireEvent("PlayerActivesCommand", { Name = name })
			task.wait(0.05)
		end
	end)
	makeButton(items, "Use All Buffs (Red)", 30, function()
		for _, name in ipairs({ "Red Extract", "Glitter", "Glue", "Oil", "Enzymes", "Tropical Drink" }) do
			fireEvent("PlayerActivesCommand", { Name = name })
			task.wait(0.05)
		end
	end)

	for index, name in ipairs(BUFFS) do
		makeButton(items, "Use " .. name, 40 + index, function()
			fireEvent("PlayerActivesCommand", { Name = name })
			setStatus("Used " .. name)
		end)
	end

	makeSection(items, "Dispensers", 100)
	makeButton(items, "Use All Dispensers", 110, function()
		for _, name in ipairs(DISPENSERS) do
			fireEvent("ToyEvent", name)
			task.wait(0.05)
		end
	end)

	showPage("Farming")

	-- Dragging
	local dragging, dragStart, startPosition = false, nil, nil

	track(logo.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPosition = true, input.Position, main.Position
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

function KronHub.start()
	if getgenv and getgenv().KronHub then
		local previous = getgenv().KronHub
		if previous ~= KronHub and previous.stop then
			pcall(previous.stop)
		end
	end

	if getgenv then
		getgenv().KronHub = KronHub
	end

	buildGui()

	local function onCharacter(character)
		local humanoid = character:WaitForChild("Humanoid")
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		end)
	end

	onCharacter(player.Character or player.CharacterAdded:Wait())
	track(player.CharacterAdded:Connect(onCharacter))

	track(player.Idled:Connect(function()
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
	end))

	task.spawn(runLoop)
end

function KronHub.stop()
	state.alive = false
	state.converting = false
	CONFIG.autoFarm = false

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)

	if gui.screenGui then
		gui.screenGui:Destroy()
		gui.screenGui = nil
	end

	if getgenv and getgenv().KronHub == KronHub then
		getgenv().KronHub = nil
	end
end

KronHub.config = CONFIG
KronHub.state = state

local ok, err = xpcall(KronHub.start, function(message)
	return tostring(message) .. "\n" .. debug.traceback()
end)

if not ok then
	warn("[KronHub] " .. tostring(err))
	KronHub.stop()
end

-- KronHub rebuild for Bee Swarm Simulator
-- Working farming loop: field walking, continuous clicking, near-only token
-- collection, hive conversion. Uses the remotes confirmed from the hub trace:
--   ReplicatedStorage.Events.ClaimHive
--   ReplicatedStorage.Events.PlayerActivesCommand  {Name = ...}
--   ReplicatedStorage.Events.ToyEvent              "Dispenser name"
--   ReplicatedStorage.Events.PlayerHiveCommand     "ToggleHoneyMaking"

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

local CONFIG = {
	field = "Sunflower",
	autoFarm = false,
	collectTokens = true,
	autoConvert = true,
	tokenMode = "Walk", -- "Walk" or "Teleport"
	tokenRadius = 55, -- only tokens this close are taken, never a cross-map token
	tickDelay = 0.05,
	clickDelay = 0.08,
	swingDelay = 0.10,
	stepDistance = 32,
	arriveRadius = 8,
	ringPoints = 12,
	waypointTimeout = 4,
	convertAt = 0.9,
	convertFallback = 150,
	convertTimeout = 45,
}

